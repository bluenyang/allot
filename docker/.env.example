# Copy to docker/.env and fill in real values. docker/.env is gitignored.
# Generate secrets with: openssl rand -base64 32

# --- PostgreSQL 16 ---
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me
POSTGRES_DB=money
# used by the api container; host "db" is the compose service
DATABASE_URL=postgres://money:change-me@db:5432/money

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-base64
# the URL you open in the browser (Vite serves the app and proxies /api)
BETTER_AUTH_URL=http://localhost:15173

# --- the single login account, created by `pnpm db:seed` ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# --- web ---
# host port for the dev server (the container always listens on 15173)
WEB_PORT=15173
