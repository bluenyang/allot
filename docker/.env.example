# Production: copy to docker/.env and fill in real values (docker/compose.yaml).
# Local development/tests: copy to docker/.env.dev with test values (docker/compose.dev.yaml).
# Both files are gitignored.
# Generate secrets with: openssl rand -base64 32

# --- PostgreSQL 16 ---
POSTGRES_USER=allot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=allot
# development: host "db" is the compose service; production: your PostgreSQL server, with a
# role that is not a superuser and has no BYPASSRLS (README: 운영 배포 → 전용 DB 롤)
DATABASE_URL=postgres://allot:change-me@db:5432/allot

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-base64
# the URL you open in the browser
#   development: http://localhost:15173 (Vite serves the app and proxies /api)
#   production:  the public URL of the app, e.g. https://allot.example.com
BETTER_AUTH_URL=http://localhost:15173

# --- the login account, created by `pnpm db:seed` ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# --- web (development) ---
# host port for the dev server (the container always listens on 15173)
WEB_PORT=15173

# --- production image (docker/compose.yaml) ---
# image tag on ghcr.io/bluenyang/allot
ALLOT_VERSION=latest
# Origins allowed to call the API with a session (comma-separated scheme://host[:port]).
# Production: always set it to the public URL(s), e.g. https://allot.example.com.
# Empty: development behaviour (trust the origin the request was sent to).
TRUSTED_ORIGINS=
# Traefik (the default in compose.yaml): host name, Traefik's docker network,
# entrypoint and certificate resolver as your Traefik names them.
ALLOT_HOST=allot.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Without Traefik (see the comment in compose.yaml): host address and port for the app
# (the container listens on 3000). 127.0.0.1 = only a reverse proxy on this host can reach it;
# 0.0.0.0 = clients connect directly, then TRUSTED_PROXY_IP_HEADER must stay empty.
APP_BIND=127.0.0.1
APP_PORT=3000
# Client IP for the login rate limit. Leave empty when clients connect to the app directly:
# the socket address is used and any client-sent header is ignored. Behind a reverse proxy,
# set the header that proxy sets and overwrites (Traefik: X-Real-IP); only then is it trusted.
# Trusting a header is safe only if clients cannot reach the app except through that proxy.
TRUSTED_PROXY_IP_HEADER=
# Change history: delete change sets older than this many days (empty = keep everything).
CHANGE_LOG_RETENTION_DAYS=
