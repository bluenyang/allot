# Copy to docker/.env and fill in real values. docker/.env is gitignored.
# Generate secrets with: openssl rand -base64 32
# Used by docker/compose.yaml (development) and docker/compose.prod.yaml (production image).

# --- PostgreSQL 16 ---
POSTGRES_USER=allot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=allot
# development: host "db" is the compose service; production: your PostgreSQL server
DATABASE_URL=postgres://allot:change-me@db:5432/allot

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-base64
# the URL you open in the browser
#   development: http://localhost:15173 (Vite serves the app and proxies /api)
#   production:  the public URL of the app, e.g. https://allot.example.com
BETTER_AUTH_URL=http://localhost:15173

# --- the single login account, created by `pnpm db:seed` ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# --- web (development) ---
# host port for the dev server (the container always listens on 15173)
WEB_PORT=15173

# --- production image (docker/compose.prod.yaml) ---
# image tag on ghcr.io/bluenyang/allot
ALLOT_VERSION=latest
# host port for the app (the container listens on 3000)
APP_PORT=3000
# Client IP for the login rate limit. Leave empty when clients connect to the app directly:
# the socket address is used and any client-sent header is ignored. Behind a reverse proxy,
# set the header that proxy sets and overwrites (e.g. X-Real-IP); only then is it trusted.
TRUSTED_PROXY_IP_HEADER=
