# Production: copy to docker/.env and fill in real values (docker/compose.yaml).
# Local development/tests: copy to docker/.env.dev with test values (docker/compose.dev.yaml).
# Both files are gitignored.
# Generate secrets with: openssl rand -base64 32

# --- PostgreSQL 16 ---
POSTGRES_USER=allot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=allot
# development: host "db" is the compose service; production: your PostgreSQL server, with a
# role that is not a superuser and has no BYPASSRLS (README: 운영 배포 → 전용 DB 롤)
DATABASE_URL=postgres://allot:change-me@db:5432/allot

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-base64
# the URL you open in the browser
#   development: http://<this computer's LAN IP>:15173 (Vite serves the app and proxies /api and
#                /dex; the api container reaches Dex at this address too, so not localhost)
#   production:  the public URL of the app, e.g. https://allot.example.com
BETTER_AUTH_URL=http://192.168.0.10:15173

# --- encryption (envelope: this key wraps the per-user data keys) ---
# Required: the app does not start without it. Keep it outside the database backups.
# Losing it loses only what is encrypted (external login tokens, client secrets entered in the
# admin screen): sign in again and enter the secrets again. Rotate: put the old key in
# ALLOT_MASTER_KEY_PREVIOUS, the new one here, run `pnpm keys:rotate` (image:
# node dist-server/index.mjs keys:rotate), then remove the old key.
ALLOT_MASTER_KEY=change-me-32-bytes-base64
ALLOT_MASTER_KEY_PREVIOUS=

# --- the first admin ---
# `pnpm db:admin` (account only) or `pnpm db:seed` (account + data) creates this account with a
# password; when the app starts, an existing account with this email is made an active admin.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Or (or also) an OIDC account: its subject at the configured OIDC issuer. Its first OIDC login
# creates an admin, whatever the sign-up policy says. Never demoted when removed later.
ADMIN_OIDC_SUBJECT=

# --- login methods (README: 로그인 방식) ---
# Each can also be set in the admin screen; a value set here wins and is locked there.
# Nothing set: only password login is on, and nobody can sign up.
# <P> = PASSWORD | OIDC | GITHUB | GOOGLE
#   AUTH_<P>_ENABLED=true|false
#   AUTH_<P>_SIGNUP=closed|approval|rules        (not PASSWORD: password sign-up stays closed)
#   AUTH_<P>_ALLOW_EMAILS=a@example.com,b@example.com   (rule: verified email in this list)
#   AUTH_<P>_CLIENT_ID= / AUTH_<P>_CLIENT_SECRET=        (OIDC, GITHUB, GOOGLE)
# OIDC only: AUTH_OIDC_DISCOVERY_URL, AUTH_OIDC_NAME (button), AUTH_OIDC_SCOPES (space-separated,
#   must include openid; add groups for Dex), AUTH_OIDC_GROUPS_CLAIM (default groups),
#   AUTH_OIDC_ALLOW_GROUPS (rule)
# GitHub: AUTH_GITHUB_ALLOW_ORGS (rule, asks for read:org) · Google: AUTH_GOOGLE_ALLOW_DOMAINS (rule)
# Password login stays on while no active admin has another login linked.
AUTH_PASSWORD_ENABLED=

# --- a mobile app's return address (README: 모바일 앱) ---
# Comma-separated, exact app URLs with the app's own scheme (e.g. allot://auth). Empty = off.
ALLOT_APP_RETURN_URLS=

# --- development only: Dex, the test OIDC provider in docker/compose.dev.yaml ---
# The api gets these through the admin screen (or AUTH_OIDC_* above) in tests.
DEX_CLIENT_ID=allot-dev
DEX_CLIENT_SECRET=change-me


# --- production image (docker/compose.yaml) ---
# image tag on ghcr.io/bluenyang/allot
ALLOT_VERSION=latest
# Origins allowed to call the API with a session (comma-separated scheme://host[:port]).
# Production: always set it to the public URL(s), e.g. https://allot.example.com.
# Empty: development behaviour (trust the origin the request was sent to).
TRUSTED_ORIGINS=
# Traefik (the default in compose.yaml): host name, Traefik's docker network,
# entrypoint and certificate resolver as your Traefik names them.
ALLOT_HOST=allot.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Without Traefik (see the comment in compose.yaml): host address and port for the app
# (the container listens on 3000). 127.0.0.1 = only a reverse proxy on this host can reach it;
# 0.0.0.0 = clients connect directly, then TRUSTED_PROXY_IP_HEADER must stay empty.
APP_BIND=127.0.0.1
APP_PORT=3000
# Client IP for the login rate limit. Leave empty when clients connect to the app directly:
# the socket address is used and any client-sent header is ignored. Behind a reverse proxy,
# set the header that proxy sets and overwrites (Traefik: X-Real-IP); only then is it trusted.
# Trusting a header is safe only if clients cannot reach the app except through that proxy.
TRUSTED_PROXY_IP_HEADER=
# Change history: delete change sets older than this many days (empty = keep everything).
CHANGE_LOG_RETENTION_DAYS=
