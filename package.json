{
  "name": "allot",
  "private": true,
  "version": "0.1.8",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json",
    "review:mark": "node scripts/guard-review.mjs --mark",
    "prepare": "node scripts/prepare.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:admin": "tsx server/db/admin-cli.ts",
    "db:seed": "tsx server/db/seed.ts",
    "keys:rotate": "tsx server/index.ts keys:rotate",
    "keys:forget-lost": "tsx server/index.ts keys:forget-lost",
    "e2e": "playwright test",
    "check:migrations": "sh scripts/check-migrations.sh",
    "check:logs": "node scripts/check-logs.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=dist-server/index.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.27",
    "@better-auth/cimd": "1.7.27",
    "@better-auth/mcp": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fullcalendar/vue3": "7.1.5",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "postgres": "4.1.0",
    "reka-ui": "2.11.0",
    "rrule-temporal": "2.2.9",
    "temporal-polyfill": "1.0.8",
    "vue": "3.5.45",
    "vue-i18n": "11.4.20",
    "vue-router": "4.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "korean-lunar-calendar": "0.4.0",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
