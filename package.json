{
  "name": "allot",
  "private": true,
  "version": "0.1.1-rc.1",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json",
    "prepare": "node scripts/prepare.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:seed": "tsx server/db/seed.ts",
    "e2e": "playwright test",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=dist-server/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "postgres": "4.1.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
